<mujoco model="custom_reacher_2dof">
  <compiler angle="radian" inertiafromgeom="true"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Base pedestal -->
    <body name="base" pos="0 0 0.05">
      <geom name="base_geom" type="cylinder" size="0.06 0.05" rgba="0.3 0.3 0.35 1" mass="1.0"/>

      <!-- Link 1: Shoulder -->
      <body name="link1" pos="0 0 0.05">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14159 3.14159" damping="0.1"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0.25 0 0" size="0.025" rgba="0.2 0.6 0.8 1" mass="0.5"/>

        <!-- Link 2: Elbow -->
        <body name="link2" pos="0.25 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-2.6 2.6" damping="0.1"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.2 0 0" size="0.02" rgba="0.9 0.5 0.2 1" mass="0.3"/>

          <!-- End-effector site -->
          <site name="ee_site" pos="0.2 0 0" size="0.02" rgba="0.2 0.9 0.3 1"/>
        </body>
      </body>
    </body>

    <!-- Target mocap / goal site -->
    <body name="target" pos="0.25 0.25 0.1">
      <joint name="target_x" type="slide" axis="1 0 0" damping="1.0"/>
      <joint name="target_y" type="slide" axis="0 1 0" damping="1.0"/>
      <geom name="target_geom" type="sphere" size="0.03" rgba="1 0.2 0.2 0.8" contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0" size="0.01"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="motor1" joint="joint1" ctrlrange="-1.0 1.0" ctrllimited="true" gear="15"/>
    <motor name="motor2" joint="joint2" ctrlrange="-1.0 1.0" ctrllimited="true" gear="10"/>
  </actuator>
</mujoco>

